# Build artifacts
bin/
# The dashboard build is produced by `make ui` or the Docker ui stage. Its
# placeholder stays tracked so go:embed has something to embed without one.
/ui/dist/*
!/ui/dist/.gitkeep
*.exe
*.exe~
*.test
*.out
coverage.txt

# Generated protobuf code is committed on purpose (see the monorepo's
# buf.gen.yaml), so gen/ is deliberately NOT ignored.

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
