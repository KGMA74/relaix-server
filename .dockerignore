# Keep the build context small and the image reproducible: anything here would
# either bloat the context or bake host state into the build.
.git
.gitignore
bin/
coverage.out
Dockerfile
.dockerignore
Makefile
README.md
LICENSE
*_test.go

# The dashboard is built inside the image from its sources and lockfile; a
# host node_modules would be the wrong platform, and a host dist/ a stale build.
ui/node_modules
ui/dist
