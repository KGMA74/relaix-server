{
  "_comment": "Shared by the gateway (policy), the agent (unit tests) and the dashboard's tester: the three must agree on what matches, what is extracted and what a template renders. Copy, do not fork.",
  "cases": [
    {
      "name": "orange money reception extracts amount, from and ref",
      "automation": {
        "enabled": true,
        "senders": [
          "OrangeMoney"
        ],
        "pattern": "Vous avez recu (?<amount>[0-9 ]+) FCFA de (?<from>\\+?[0-9]+)\\. Ref: (?<ref>[A-Z0-9]+\\.[0-9]+)",
        "conditions": [
          {
            "field": "amount",
            "op": "gte",
            "value": "1000"
          }
        ]
      },
      "sms": {
        "sender": "orangemoney",
        "body": "Vous avez recu 5 000 FCFA de 70123456. Ref: CI230512.1234. Nouveau solde: 12 500 FCFA",
        "receivedAt": "2026-10-13T08:00:00Z",
        "sim": 1
      },
      "match": true,
      "fields": {
        "amount": "5 000",
        "from": "70123456",
        "ref": "CI230512.1234",
        "sender": "orangemoney",
        "sim": "1"
      },
      "template": "Merci, {amount} FCFA bien recus (ref {ref}).",
      "rendered": "Merci, 5 000 FCFA bien recus (ref CI230512.1234)."
    },
    {
      "name": "a condition below its threshold stops the match",
      "automation": {
        "enabled": true,
        "pattern": "recu (?<amount>[0-9 ]+) FCFA",
        "conditions": [
          {
            "field": "amount",
            "op": "gt",
            "value": "10 000"
          }
        ]
      },
      "sms": {
        "sender": "OrangeMoney",
        "body": "Vous avez recu 5 000 FCFA",
        "receivedAt": "2026-10-13T08:00:00Z",
        "sim": 0
      },
      "match": false
    },
    {
      "name": "another sender does not match",
      "automation": {
        "enabled": true,
        "senders": [
          "OrangeMoney"
        ],
        "pattern": "recu"
      },
      "sms": {
        "sender": "MoovMoney",
        "body": "Vous avez recu 5000 FCFA",
        "receivedAt": "2026-10-13T08:00:00Z",
        "sim": 0
      },
      "match": false
    },
    {
      "name": "another SIM does not match",
      "automation": {
        "enabled": true,
        "subscriptionId": 2
      },
      "sms": {
        "sender": "OrangeMoney",
        "body": "x",
        "receivedAt": "2026-10-13T08:00:00Z",
        "sim": 1
      },
      "match": false
    },
    {
      "name": "a disabled automation never matches",
      "automation": {
        "enabled": false
      },
      "sms": {
        "sender": "OrangeMoney",
        "body": "x",
        "receivedAt": "2026-10-13T08:00:00Z",
        "sim": 0
      },
      "match": false
    },
    {
      "name": "no pattern: builtins only, contains is case-insensitive",
      "automation": {
        "enabled": true,
        "conditions": [
          {
            "field": "body",
            "op": "contains",
            "value": "SOLDE"
          }
        ]
      },
      "sms": {
        "sender": "+22670000000",
        "body": "Votre solde est de 1500 F",
        "receivedAt": "2026-10-13T08:00:00Z",
        "sim": 1
      },
      "match": true,
      "fields": {
        "sender": "+22670000000",
        "sim": "1"
      },
      "template": "{sender} a ecrit: {body}",
      "rendered": "+22670000000 a ecrit: Votre solde est de 1500 F"
    },
    {
      "name": "decimal comma",
      "automation": {
        "enabled": true,
        "pattern": "(?<amount>[0-9]+,[0-9]+) EUR",
        "conditions": [
          {
            "field": "amount",
            "op": "lt",
            "value": "10.5"
          }
        ]
      },
      "sms": {
        "sender": "Bank",
        "body": "Debit 10,25 EUR",
        "receivedAt": "2026-10-13T08:00:00Z",
        "sim": 0
      },
      "match": true,
      "fields": {
        "amount": "10,25"
      }
    },
    {
      "name": "a JSON body: quoted fields escaped, bare fields typed",
      "automation": {
        "enabled": true,
        "senders": [
          "OrangeMoney"
        ],
        "pattern": "Vous avez recu (?<amount>[0-9 ]+) FCFA de (?<from>\\+?[0-9]+)\\. Ref: (?<ref>[A-Z0-9]+\\.[0-9]+)"
      },
      "sms": {
        "sender": "OrangeMoney",
        "body": "Vous avez recu 5 000 FCFA de 70123456. Ref: CI230512.1234.\nMotif: \"loyer\" C:\\dossier",
        "receivedAt": "2026-10-13T08:00:00Z",
        "sim": 1
      },
      "match": true,
      "fields": {
        "amount": "5 000",
        "from": "70123456",
        "ref": "CI230512.1234"
      },
      "jsonTemplate": "{\"montant\": {amount}, \"de\": \"{from}\", \"ref\": \"{ref}\", \"texte\": \"{body}\", \"sim\": {sim}, \"aussi\": \"{amount} FCFA\"}",
      "jsonRendered": "{\"montant\": 5000, \"de\": \"70123456\", \"ref\": \"CI230512.1234\", \"texte\": \"Vous avez recu 5 000 FCFA de 70123456. Ref: CI230512.1234.\\nMotif: \\\"loyer\\\" C:\\\\dossier\", \"sim\": 1, \"aussi\": \"5 000 FCFA\"}",
      "numbers": {
        "amount": "5000",
        "from": "70123456"
      }
    },
    {
      "name": "a JSON body: decimal comma, an unquoted phone number stays text, an empty field is null",
      "automation": {
        "enabled": true,
        "pattern": "solde est de (?<balance>[0-9 ]+(?:,[0-9]+)?) FCFA(?: ref (?<ref>[A-Z0-9]+))?"
      },
      "sms": {
        "sender": "+22670123456",
        "body": "Votre solde est de 684,62 FCFA",
        "receivedAt": "2026-10-13T08:00:00Z",
        "sim": 0
      },
      "match": true,
      "fields": {
        "balance": "684,62",
        "ref": ""
      },
      "jsonTemplate": "[{balance}, {sender}, {ref}, \"{balance}\", {sim}]",
      "jsonRendered": "[684.62, \"+22670123456\", null, \"684,62\", 0]",
      "numbers": {
        "balance": "684.62"
      }
    },
    {
      "name": "calculation: text, JSON and USSD from a decimal amount",
      "automation": {
        "enabled": true,
        "senders": [
          "OrangeMoney"
        ],
        "pattern": "Vous avez recu (?<amount>[0-9 .,]+) FCFA de (?<from>[0-9]+)"
      },
      "sms": {
        "sender": "OrangeMoney",
        "body": "Vous avez recu 200.0 FCFA de 65530101. Solde 1 500 FCFA",
        "receivedAt": "2026-10-19T08:00:00Z",
        "sim": 1
      },
      "match": true,
      "fields": {
        "amount": "200.0",
        "from": "65530101"
      },
      "template": "Frais {amount * 0.02} FCFA, total {(amount + 50) * 2}, tiers {amount / 3}, {amount-from*0} {1.5} {amount}",
      "rendered": "Frais 4 FCFA, total 500, tiers 66.67, 200 {1.5} 200.0",
      "jsonTemplate": "{\"double\": {amount * 2}, \"text\": \"{amount / 3}\", \"bad\": {from / (amount - amount)}, \"neg\": {-amount + 50}}",
      "jsonRendered": "{\"double\": 400, \"text\": \"66.67\", \"bad\": null, \"neg\": -150}",
      "ussdTemplate": "*144*2*1*{from}*{amount * 2}#",
      "ussdRendered": "*144*2*1*65530101*400#"
    },
    {
      "name": "calculation: a USSD result is rounded to a whole number, spaces read as an amount",
      "automation": {
        "enabled": true,
        "senders": [
          "OrangeMoney"
        ],
        "pattern": "Vous avez recu (?<amount>[0-9 .,]+) FCFA de (?<from>[0-9]+)"
      },
      "sms": {
        "sender": "OrangeMoney",
        "body": "Vous avez recu 5 000,50 FCFA de 70123456",
        "receivedAt": "2026-10-19T08:00:00Z",
        "sim": 1
      },
      "match": true,
      "fields": {
        "amount": "5 000,50",
        "from": "70123456"
      },
      "template": "{amount * 2}",
      "rendered": "10001",
      "ussdTemplate": "*144*{amount / 3}*{amount}#",
      "ussdRendered": "*144*1667*5000,50#"
    },
    {
      "name": "calculation: a field that is not a number cannot be computed, and the code is not dialable",
      "automation": {
        "enabled": true,
        "pattern": "de (?<who>[A-Za-z]+)"
      },
      "sms": {
        "sender": "x",
        "body": "recu de Awa",
        "receivedAt": "2026-10-19T08:00:00Z",
        "sim": 1
      },
      "match": true,
      "fields": {
        "who": "Awa"
      },
      "template": "[{who * 2}]",
      "rendered": "[]",
      "ussdTemplate": "*144*{who * 2}#",
      "ussdRendered": "*144*?#"
    }
  ],
  "extractions": [
    {
      "name": "the balance from the first of two screens",
      "extract": "Compte Normal est de (?<solde>[0-9 .,]+) FCFA",
      "screens": [
        "Le solde de votre Compte Normal est de 20158.62 FCFA. Le solde de votre Compte Compte Retrait Gratuit est de 0.00 FCFA. Le solde de votre\nn Suivant",
        "Compte Epargne est de 1500.00 FCFA.\n0 Retour"
      ],
      "match": true,
      "fields": {
        "solde": "20158.62"
      }
    },
    {
      "name": "a field that only the next screen holds: screens are joined by a line break",
      "extract": "Le solde de votre\\s+n Suivant\\s+Compte Epargne est de (?<epargne>[0-9 .,]+) FCFA",
      "screens": [
        "Le solde de votre Compte Normal est de 20158.62 FCFA. Le solde de votre\nn Suivant",
        "Compte Epargne est de 1500.00 FCFA.\n0 Retour"
      ],
      "match": true,
      "fields": {
        "epargne": "1500.00"
      }
    },
    {
      "name": "nothing found: no fields",
      "extract": "Compte Normal est de (?<solde>[0-9 .,]+) FCFA",
      "screens": [
        "Service momentanement indisponible"
      ],
      "match": false,
      "fields": {}
    }
  ]
}
